---
// LamarCy — the songwriter's world, stripped to three sticky notes on fog.
//
// Everything that used to live here (yin/yang hero, live Instagram grid, two
// newsletter capture forms, The Chronicle) is gone by request; git history has
// it if any of it is wanted back.
//
// What survives, deliberately: the direct-sales path. The store script at the
// bottom of this file is byte-for-byte the one that was already running in
// production, and the markup below keeps every hook it reaches for —
// button.cta.buy[data-sku], .closest('.song'), .playrow with .pbtn/.pbar/
// .pfill/.ptime, and .closest('.body') holding .buynote/.buyerr. The initial
// display:none on those is also preserved: the script reveals players only
// once a master is uploaded and buy buttons only once Stripe is configured,
// so the store ships dark and lights up in stages.
const SINGLES = [
  { sku: 'lowcountry', title: 'Lowcountry Beach', art: '/gateway/single-lowcountry.jpg',
    credits: 'Written, played & sung by Durrell Lamar · LC-001' },
  { sku: 'momma', title: 'Momma Gone', art: '/gateway/single-momma.jpg',
    credits: 'Written by Durrell Lamar · Vocals by Ashley Eady Smith' },
];
---

<div id="lcworld">
  <div class="lcfog" aria-hidden="true"><span class="a"></span><span class="b"></span><span class="c"></span></div>

  <!-- The blue heart is the way back to the gateway. -->
  <a class="lcheart" href="/" aria-label="Back to C.PRICE — pick a world">
    <img src="/gateway/heart.png" alt="" width="92" height="84" />
    <span class="lcheart-lbl">pick a world</span>
  </a>

  <div class="lcrow">
    <!-- 1 · the identity note: Durrell's own photograph, same as the gateway -->
    <div class="lcnote" data-spin>
      <div class="lcfaces">
        <div class="lcface lcfront is-photo">
          <img src="/gateway/note-lamarcy.webp" alt="LamarCy — The Songwriter" width="372" height="380" />
        </div>
        <div class="lcface lcback" aria-hidden="true"></div>
      </div>
    </div>

    {SINGLES.map((s) => (
      <div class="lcnote song" data-spin>
        <div class="lcfaces">
          <div class="lcface lcfront paper">
            <div class="body">
              <img class="art" src={s.art} alt={`${s.title} single art`} loading="lazy" decoding="async" />
              <h3 class="hand">{s.title}</h3>
              <div class="credits">{s.credits}</div>

              <div class="playrow no-spin">
                <button class="pbtn" type="button" aria-label={`Play ${s.title}`}>▶</button>
                <div class="pbar"><div class="pfill"></div></div>
                <div class="ptime">0:00 / 0:00</div>
              </div>

              <button class="cta buy no-spin" type="button" data-sku={s.sku}>Own it · $0.99+</button>
              <div class="buynote">MP3 · pay what you want · Stripe</div>
              <div class="buyerr"></div>
            </div>
          </div>
          <div class="lcface lcback" aria-hidden="true"></div>
        </div>
      </div>
    ))}
  </div>
</div>

<style is:global>
@font-face{font-family:'DashHand';src:url('/gateway/RockSalt.ttf');font-display:swap}

#lcworld{
  position:relative;min-height:100vh;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  background:radial-gradient(ellipse 110% 95% at 50% 42%,
    #fafaf9 0%, #f3f3f1 26%, #ebebe8 48%, #e0e0dc 74%, #d4d4cf 100%);
  perspective:1400px;
}
#lcworld .lcfog{position:absolute;inset:-12%;pointer-events:none;z-index:1}
#lcworld .lcfog span{
  position:absolute;border-radius:50%;
  background:radial-gradient(ellipse at 50% 50%, rgba(255,255,255,.9) 0%,
    rgba(255,255,255,.6) 44%, rgba(255,255,255,0) 74%);
  filter:blur(46px);will-change:transform;
}
#lcworld .lcfog .a{width:60vw;height:38vh;left:-8%;top:14%;animation:lcdrift 31s ease-in-out infinite}
#lcworld .lcfog .b{width:48vw;height:32vh;right:-10%;top:30%;animation:lcdrift 37s ease-in-out infinite reverse}
#lcworld .lcfog .c{width:66vw;height:34vh;left:16%;bottom:6%;animation:lcdrift 26s ease-in-out infinite}
@keyframes lcdrift{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(6%,-2%,0)}}

/* ---- the row ---- */
#lcworld .lcrow{
  --nw:clamp(200px, 22vw, 290px);
  position:relative;z-index:3;
  display:flex;align-items:center;justify-content:center;
  gap:clamp(18px,3.4vw,54px);padding:0 24px;max-width:100%;
}

/* ---- a spinnable note ---- */
#lcworld .lcnote{
  width:var(--nw);height:var(--nw);flex:0 0 auto;
  touch-action:none;                    /* we drive the drag ourselves */
  animation:lcbob 10s ease-in-out infinite;
  will-change:transform;
}
#lcworld .lcnote:nth-child(2){animation-duration:12s;animation-delay:-3s}
#lcworld .lcnote:nth-child(3){animation-duration:9s;animation-delay:-6s}
@keyframes lcbob{0%,100%{transform:translate3d(0,7px,0)}50%{transform:translate3d(0,-7px,0)}}

/* The inner element carries the rotation, so bobbing and spinning never
   fight over the same transform. */
#lcworld .lcfaces{
  position:relative;width:100%;height:100%;
  transform-style:preserve-3d;
  transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
  cursor:grab;
}
#lcworld .lcnote.dragging .lcfaces{cursor:grabbing}
#lcworld .lcface{position:absolute;inset:0;backface-visibility:hidden;border-radius:2px}
#lcworld .lcback{
  transform:rotateY(180deg);
  background:linear-gradient(170deg,#EDE49A 0%,#E6DB86 60%,#DCCF74 100%);
  box-shadow:0 12px 22px -10px rgba(104,96,48,.20), inset 0 1px 0 rgba(255,255,255,.4);
}
/* While a note is showing its back, its controls must not be clickable
   through the paper. */
#lcworld .lcnote.flipped .lcfront{pointer-events:none}

#lcworld .lcfront.is-photo img{display:block;width:100%;height:100%;object-fit:contain;
  filter:drop-shadow(0 10px 18px rgba(104,96,48,.17))}

#lcworld .lcfront.paper{
  background:
    linear-gradient(196deg, rgba(255,255,255,.55) 0%, rgba(255,255,255,0) 34%),
    linear-gradient(170deg,#F6E9A0 0%,#F0E28A 56%,#E7D678 100%);
  box-shadow:0 12px 22px -10px rgba(104,96,48,.20),
             0 2px 6px rgba(104,96,48,.10), inset 0 1px 0 rgba(255,255,255,.5);
  display:flex;align-items:center;justify-content:center;
}
#lcworld .lcfront.paper .body{
  width:100%;padding:0 9% ;box-sizing:border-box;text-align:center;
}
#lcworld .art{
  display:block;width:46%;aspect-ratio:1;object-fit:cover;margin:0 auto 6%;
  border-radius:2px;box-shadow:0 6px 14px rgba(90,84,44,.34);
}
#lcworld .lcfront .hand{
  font-family:'DashHand',cursive;font-weight:400;
  font-size:calc(var(--nw) * .072);line-height:1.2;color:#2E2A22;margin:0 0 3%;
}
#lcworld .credits{
  font-family:'Oswald',sans-serif;text-transform:uppercase;
  font-size:calc(var(--nw) * .034);letter-spacing:1.5px;color:#5c5636;
  line-height:1.45;margin-bottom:6%;
}

/* ---- store controls — classes and initial states preserved verbatim ---- */
#lcworld .song .playrow{display:none;align-items:center;gap:8px;margin-bottom:5%}
#lcworld .pbtn{
  flex:0 0 auto;width:calc(var(--nw)*.115);height:calc(var(--nw)*.115);
  border-radius:50%;border:1.5px solid rgba(46,42,34,.5);background:rgba(255,255,255,.45);
  color:#2E2A22;font-size:calc(var(--nw)*.05);line-height:1;cursor:pointer;
}
#lcworld .pbar{flex:1;height:4px;border-radius:2px;background:rgba(46,42,34,.22);cursor:pointer}
#lcworld .pfill{height:100%;width:0;border-radius:2px;background:#067874}
#lcworld .ptime{
  flex:0 0 auto;font-family:'Oswald',sans-serif;
  font-size:calc(var(--nw)*.032);letter-spacing:1px;color:#5c5636;
}
#lcworld .song button.cta.buy{
  display:none;border:0;cursor:pointer;background:#067874;color:#F7F3E8;
  font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:2px;
  font-size:calc(var(--nw)*.038);padding:3.4% 7%;border-radius:2px;
}
#lcworld .song button.cta.buy:hover{background:#05605d}
#lcworld .song button.cta.buy:disabled{opacity:.7;cursor:default}
#lcworld .song .buynote{
  display:none;font-family:'Oswald',sans-serif;text-transform:uppercase;
  font-size:calc(var(--nw)*.028);letter-spacing:1.4px;color:#6b6440;margin-top:4%;
}
#lcworld .song .buyerr{display:none;font-size:calc(var(--nw)*.032);color:#7a3226;margin-top:4%;font-style:italic}

/* ---- the heart, as navigation ---- */
#lcworld .lcheart{
  position:fixed;left:26px;top:26px;z-index:40;
  display:flex;align-items:center;gap:10px;text-decoration:none;
  padding:8px 14px 8px 8px;border-radius:999px;
  background:rgba(255,255,255,.5);border:1px solid rgba(20,20,18,.12);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  transition:transform .16s ease, background .16s ease;
}
#lcworld .lcheart img{display:block;width:34px;height:auto}
#lcworld .lcheart-lbl{
  font-family:'Oswald',sans-serif;text-transform:uppercase;
  font-size:10px;letter-spacing:3px;color:#1c4f4d;
}
#lcworld .lcheart:hover{transform:scale(1.05);background:rgba(255,255,255,.75)}
#lcworld .lcheart:focus-visible{outline:3px solid #067874;outline-offset:4px}

@media (max-width:860px){
  #lcworld .lcrow{
    --nw:min(72vw,300px);
    justify-content:flex-start;overflow-x:auto;overflow-y:hidden;
    scroll-snap-type:x proximity;overscroll-behavior-x:contain;
    padding:0 max(16px,calc(50vw - (var(--nw)/2)));scrollbar-width:none;
  }
  #lcworld .lcrow::-webkit-scrollbar{display:none}
  #lcworld .lcnote{scroll-snap-align:center}
  #lcworld .lcheart{left:14px;top:14px}
}
html,body{max-width:100%;overflow-x:hidden}

@media (prefers-reduced-motion:reduce){
  #lcworld .lcfog span,#lcworld .lcnote{animation:none!important}
}
</style>

<script is:inline>
// ---- SPIN: drag a note in 3D, let it coast ------------------------------
// Pointer drag rotates the inner .lcfaces; releasing hands the remaining
// velocity to a decay loop. A drag only starts after the pointer has moved a
// few pixels, so a plain click on Play or Buy still registers as a click —
// and controls marked .no-spin never start a drag at all.
(function(){
  const notes = document.querySelectorAll('#lcworld .lcnote[data-spin]');
  if (!notes.length) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const note of notes){
    const faces = note.querySelector('.lcfaces');
    let rx = 0, ry = 0, vx = 0, vy = 0;
    let down = false, dragging = false, sx = 0, sy = 0, lx = 0, ly = 0, raf = 0;

    const paint = () => {
      faces.style.setProperty('--rx', rx.toFixed(2) + 'deg');
      faces.style.setProperty('--ry', ry.toFixed(2) + 'deg');
      // cos < 0 means we are looking at the back of the paper
      const flipped = Math.cos(ry * Math.PI / 180) < 0;
      note.classList.toggle('flipped', flipped);
    };

    const coast = () => {
      vx *= 0.94; vy *= 0.94;
      rx = Math.max(-70, Math.min(70, rx + vy));
      ry += vx;
      paint();
      raf = (Math.abs(vx) > 0.02 || Math.abs(vy) > 0.02) ? requestAnimationFrame(coast) : 0;
    };

    note.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      if (e.target.closest('.no-spin')) return;      // Play / Buy keep their clicks
      down = true; dragging = false;
      sx = lx = e.clientX; sy = ly = e.clientY;
      vx = vy = 0;
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
    });

    note.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - lx, dy = e.clientY - ly;
      if (!dragging && Math.hypot(e.clientX - sx, e.clientY - sy) < 6) return;
      if (!dragging){
        dragging = true;
        note.classList.add('dragging');
        note.setPointerCapture(e.pointerId);
      }
      ry += dx * 0.45;
      rx = Math.max(-70, Math.min(70, rx - dy * 0.45));
      vx = dx * 0.45; vy = -dy * 0.45;
      lx = e.clientX; ly = e.clientY;
      paint();
    });

    const release = (e) => {
      if (!down) return;
      down = false;
      if (dragging){
        note.classList.remove('dragging');
        try { note.releasePointerCapture(e.pointerId); } catch (_) {}
        if (!reduce && (Math.abs(vx) > 0.2 || Math.abs(vy) > 0.2)) raf = requestAnimationFrame(coast);
      }
    };
    note.addEventListener('pointerup', release);
    note.addEventListener('pointercancel', release);

    // A drag must never also fire the click underneath it.
    note.addEventListener('click', (e) => { if (dragging) { e.preventDefault(); e.stopPropagation(); } }, true);
  }
})();
</script>

<script is:inline>
// ---- THE LISTENING POST + DIRECT SALES ----------------------------------
// Players appear when a single's master is uploaded; Buy buttons appear when
// Stripe is also configured — so this ships dark, then lights up in stages.
(function(){
  const buttons = document.querySelectorAll('button.cta.buy');
  if (!buttons.length) return;
  const players = {};
  const fmt = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s/60) + ':' + String(s%60).padStart(2,'0'); };

  function initPlayer(card, sku){
    const row = card.querySelector('.playrow');
    if (!row || players[sku]) return;
    const btn = row.querySelector('.pbtn'), bar = row.querySelector('.pbar'),
          fill = row.querySelector('.pfill'), time = row.querySelector('.ptime');
    const audio = new Audio('/store/play?sku=' + sku + '&v=2');
    audio.preload = 'metadata';
    players[sku] = audio;
    row.style.display = 'flex';
    const paint = () => {
      fill.style.width = audio.duration ? (audio.currentTime / audio.duration * 100) + '%' : '0%';
      time.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
    };
    audio.addEventListener('loadedmetadata', paint);
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('play',  () => { btn.textContent = 'Ⅱ'; });
    audio.addEventListener('pause', () => { btn.textContent = '▶'; });
    audio.addEventListener('ended', () => { btn.textContent = '▶'; paint(); });
    btn.addEventListener('click', () => {
      if (audio.paused){
        for (const k in players) if (k !== sku) players[k].pause();
        audio.play().catch(()=>{});
      } else audio.pause();
    });
    bar.addEventListener('click', e => {
      if (!isFinite(audio.duration) || !audio.duration) return;
      const r = bar.getBoundingClientRect();
      audio.currentTime = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1) * audio.duration;
    });
  }

  fetch('/store/status').then(r => r.ok ? r.json() : null).then(s => {
    if (!s) return;
    for (const btn of buttons){
      const sku = btn.dataset.sku, card = btn.closest('.song');
      if (s.files && s.files[sku] && card) initPlayer(card, sku);
      if (s.ready && s.ready[sku]){
        btn.style.display = 'inline-block';
        const note = btn.closest('.body').querySelector('.buynote');
        if (note) note.style.display = 'block';
      }
    }
  }).catch(()=>{ /* store stays dark */ });

  for (const btn of buttons){
    btn.addEventListener('click', async () => {
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Opening checkout…';
      try {
        const r = await fetch('/store/checkout', {
          method: 'POST',
          headers: {'content-type':'application/json'},
          body: JSON.stringify({ sku: btn.dataset.sku })
        });
        const data = await r.json();
        if (data && data.ok && data.url){ location.href = data.url; return; }
        throw new Error((data && data.error) || 'checkout_failed');
      } catch (err){
        btn.disabled = false; btn.textContent = label;
        const errEl = btn.closest('.body').querySelector('.buyerr');
        if (errEl){ errEl.textContent = 'Checkout could not open — please try again in a minute.'; errEl.style.display = 'block'; }
      }
    });
  }
})();
</script>

