<script is:inline>
// ---- THE CAPTURE: source attribution + submit ---------------------------
// Wires every form marked [data-capture] on the page (the Chronicle block
// here, the gateway footer's one-liner). Endpoint is a Netlify Function.
(function(){
  // ===================== CONFIG =====================
  // Channel map: ?s=<key> → the `source` field stored on the subscriber.
  // The matching Kit TAG for each source is mapped server-side in
  // netlify/functions/subscribe.mts, so tag IDs never reach the browser.
  const SOURCE_MAP = {
    yt:  'youtube-shorts',
    ytl: 'youtube-longform',
    ig:  'instagram-reels',
    igb: 'instagram-bio',
    bc:  'bandcamp',
    sub: 'substack'
  };
  const DEFAULT_SOURCE = 'direct';

  // NOT /api/subscribe: netlify.toml already proxies /api/* to the Render
  // backend with force=true, which would swallow this call. The function
  // claims this path itself via `export const config`.
  const ENDPOINT = '/list/subscribe';
  const STORE_KEY = 'lc_source';
  const REF_KEY = 'lc_referrer';
  // ==================================================

  // Capture on arrival and persist: the visitor may crack the diamond, pick
  // an egg and scroll a long way before subscribing, and the egg journey
  // rewrites the URL state. sessionStorage outlives all of it.
  function resolveSource(){
    let stored = null;
    try { stored = sessionStorage.getItem(STORE_KEY); } catch(e){}
    const raw = new URLSearchParams(location.search).get('s');
    if (raw){
      const mapped = SOURCE_MAP[raw.toLowerCase().trim()] || DEFAULT_SOURCE;
      try {
        sessionStorage.setItem(STORE_KEY, mapped);
        // First touch wins for referrer too — record it once, on arrival.
        if (!sessionStorage.getItem(REF_KEY)) sessionStorage.setItem(REF_KEY, document.referrer || '');
      } catch(e){}
      return mapped;
    }
    if (stored) return stored;
    try {
      sessionStorage.setItem(STORE_KEY, DEFAULT_SOURCE);
      if (!sessionStorage.getItem(REF_KEY)) sessionStorage.setItem(REF_KEY, document.referrer || '');
    } catch(e){}
    return DEFAULT_SOURCE;
  }
  const SOURCE = resolveSource();
  function referrer(){
    try { return sessionStorage.getItem(REF_KEY) || document.referrer || ''; }
    catch(e){ return document.referrer || ''; }
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function initCapture(form){
    const input = form.querySelector('input[type=email]');
    const btn = form.querySelector('button[type=submit]');
    const status = form.querySelector('[data-status]');
    const pot = form.querySelector('input[name=company]');
    const idleLabel = btn ? btn.textContent : '';
    if (!input || !btn) return;

    const say = (msg, isErr) => {
      if (!status) return;
      status.textContent = msg || '';
      status.classList.toggle('err', !!isErr);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (input.value || '').trim();

      // Bot filled the honeypot: look successful, send nothing.
      if (pot && pot.value){ succeed(); return; }

      if (!EMAIL_RE.test(email) || email.length > 200){
        input.setAttribute('aria-invalid','true');
        say('That email doesn’t look right. Check it and try again?', true);
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');

      btn.disabled = true;
      btn.textContent = 'Sending…';
      say('');

      try {
        const r = await fetch(ENDPOINT, {
          method: 'POST',
          headers: {'content-type':'application/json'},
          body: JSON.stringify({
            email: email,
            source: SOURCE,
            referrer: referrer(),
            form: form.dataset.capture || 'chronicle'
          })
        });
        const data = await r.json().catch(() => null);
        if (r.ok && data && data.ok){ succeed(); return; }
        throw new Error('subscribe_failed');
      } catch (err){
        btn.disabled = false;
        btn.textContent = idleLabel;
        say('That didn’t go through. Try again?', true);
      }
    });

    // Success replaces the form outright — the one heart this block gets.
    function succeed(){
      const done = document.createElement('div');
      done.className = 'cap-done';
      done.setAttribute('role','status');
      done.innerHTML = '<span class="h" aria-hidden="true">❤</span>' +
        '<span class="t">You’re in. First entry hits Saturday.</span>';
      form.replaceWith(done);
    }
  }

  for (const form of document.querySelectorAll('form[data-capture]')) initCapture(form);
})();
</script>
<script is:inline>
// ---- THE LISTENING POST + DIRECT SALES ----------------------------------
// Players appear when a single's master is uploaded; Buy buttons appear when
// Stripe is also configured — so this ships dark, then lights up in stages.
(function(){
  const buttons = document.querySelectorAll('button.cta.buy');
  if (!buttons.length) return;
  const players = {};
  const fmt = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s/60) + ':' + String(s%60).padStart(2,'0'); };

  function initPlayer(card, sku){
    const row = card.querySelector('.playrow');
    if (!row || players[sku]) return;
    const btn = row.querySelector('.pbtn'), bar = row.querySelector('.pbar'),
          fill = row.querySelector('.pfill'), time = row.querySelector('.ptime');
    const audio = new Audio('/store/play?sku=' + sku + '&v=2');
    audio.preload = 'metadata';
    players[sku] = audio;
    row.style.display = 'flex';
    const paint = () => {
      fill.style.width = audio.duration ? (audio.currentTime / audio.duration * 100) + '%' : '0%';
      time.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
    };
    audio.addEventListener('loadedmetadata', paint);
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('play',  () => { btn.textContent = 'Ⅱ'; });
    audio.addEventListener('pause', () => { btn.textContent = '▶'; });
    audio.addEventListener('ended', () => { btn.textContent = '▶'; paint(); });
    btn.addEventListener('click', () => {
      if (audio.paused){
        for (const k in players) if (k !== sku) players[k].pause();
        audio.play().catch(()=>{});
      } else audio.pause();
    });
    bar.addEventListener('click', e => {
      if (!isFinite(audio.duration) || !audio.duration) return;
      const r = bar.getBoundingClientRect();
      audio.currentTime = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1) * audio.duration;
    });
  }

  fetch('/store/status').then(r => r.ok ? r.json() : null).then(s => {
    if (!s) return;
    for (const btn of buttons){
      const sku = btn.dataset.sku, card = btn.closest('.song');
      if (s.files && s.files[sku] && card) initPlayer(card, sku);
      if (s.ready && s.ready[sku]){
        btn.style.display = 'inline-block';
        const note = btn.closest('.body').querySelector('.buynote');
        if (note) note.style.display = 'block';
      }
    }
  }).catch(()=>{ /* store stays dark */ });

  for (const btn of buttons){
    btn.addEventListener('click', async () => {
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Opening checkout…';
      try {
        const r = await fetch('/store/checkout', {
          method: 'POST',
          headers: {'content-type':'application/json'},
          body: JSON.stringify({ sku: btn.dataset.sku })
        });
        const data = await r.json();
        if (data && data.ok && data.url){ location.href = data.url; return; }
        throw new Error((data && data.error) || 'checkout_failed');
      } catch (err){
        btn.disabled = false; btn.textContent = label;
        const errEl = btn.closest('.body').querySelector('.buyerr');
        if (errEl){ errEl.textContent = 'Checkout could not open — please try again in a minute.'; errEl.style.display = 'block'; }
      }
    });
  }
})();
</script>
