<script is:inline>
(function(){
  var COLS=10, ROWS=6, N=60, CW=312, CH=324, FPS=12;

  var spin=document.getElementById('spin');
  spin.style.aspectRatio   = CW+'/'+CH;
  spin.style.backgroundSize= (COLS*100)+'% '+(ROWS*100)+'%';

  function place(i){
    var c=i%COLS, r=(i/COLS)|0;
    spin.style.backgroundPosition =
      (COLS>1 ? c*100/(COLS-1) : 0)+'% ' + (ROWS>1 ? r*100/(ROWS-1) : 0)+'%';
  }
  place(0);

  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce){
    // time-based, so a slow frame drops a step instead of slowing the rotation
    var t0=performance.now(), last=-1;
    (function tick(now){
      var i = Math.floor(((now-t0)/1000)*FPS) % N;
      if (i!==last){ place(i); last=i; }
      requestAnimationFrame(tick);
    })(t0);
  }

  var sp=document.getElementById('splash'), s0=performance.now();
  function go(){ sp.classList.add('done'); }
  var im=new Image(); im.src='/memorials/setter_turntable.webp';
  function ready(){ setTimeout(go, Math.max(0, 3600-(performance.now()-s0))); }
  if (im.complete) ready(); else { im.onload=ready; im.onerror=ready; }
  setTimeout(go, 7000);
})();
</script>
