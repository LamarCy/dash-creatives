---
// /memorials — DASH Memorial Art. Destination of the rust egg on the gateway.
//
// The body of this page is a FAITHFUL PORT of the "Landing page" artboard from
// the Claude Design file (~/Desktop/design_handoff_pet_urns_website/). The
// markup and its inline styles are the design's own — do not "tidy" them by
// hand; re-export from the design file and re-run the port instead, or the two
// will drift. Only four things were changed on the way in:
//   1. asset paths rewritten to /memorials/*
//   2. the three invented customer testimonials removed (the studio has not
//      delivered to an outside client yet; the Share Your Story card stays)
//   3. matcha #5C6B42 -> #4E5A3A, which the design file also carries now
//   4. responsive overrides added below, since the artboard is a fixed 1440px
//
// Added around it: the turntable splash, the shared OrbNav, and SEO/meta.
import OrbNav from '../components/OrbNav.astro';

const SITE  = 'https://dashcreatives.art';
const TITLE = 'Custom Pet Memorial Urns — sculpted from your photographs | DASH Creatives';
const DESC  = 'A one-of-one sculpture of your own companion, modeled from your photographs and finished by hand in our studio. One piece, one price: $950.';
const OG    = `${SITE}/memorials/gd_03.jpg`;
---
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{TITLE}</title>
<meta name="description" content={DESC}>
<link rel="canonical" href={`${SITE}/memorials`}>
<meta property="og:type" content="product">
<meta property="og:site_name" content="DASH Creatives">
<meta property="og:title" content={TITLE}>
<meta property="og:description" content={DESC}>
<meta property="og:image" content={OG}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<script type="application/ld+json" set:html={JSON.stringify({
  "@context":"https://schema.org","@type":"Product",
  "name":"Custom Pet Memorial Urn — one-of-one sculpted commission",
  "description":DESC,"image":OG,"brand":{"@type":"Brand","name":"DASH Creatives"},
  "offers":{"@type":"Offer","price":"950","priceCurrency":"USD",
            "availability":"https://schema.org/InStock","url":`${SITE}/memorials`}
})} />
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#F0EAD9;font-family:'Playfair Display',Georgia,serif;color:#2B2620;
       -webkit-font-smoothing:antialiased}
  img{max-width:100%}

  /* The artboard is authored at a fixed 1440px. Centre it, let it shrink, and
     collapse only the handful of fixed grids it contains. Overrides are by
     inline-style substring because that is what the ported markup carries. */
  #design{width:100%;max-width:1440px;margin:0 auto;position:relative;
          isolation:isolate;overflow:hidden;
          background:#F0EAD9 url('/memorials/papyrus.svg') center/cover}
  @media (max-width:1180px){
    #design [style*="grid-template-columns:1fr 560px"]{
      grid-template-columns:1fr!important;gap:44px!important}
    #design [style*="grid-template-columns:1fr 1fr 1fr"]{
      grid-template-columns:1fr 1fr!important}
    #design [style*="padding:90px 100px"],
    #design [style*="padding:80px 100px"],
    #design [style*="padding:70px 100px"],
    #design [style*="padding:20px 100px 90px"],
    #design [style*="padding:0 100px 90px"],
    #design [style*="padding:20px 100px 100px"],
    #design [style*="padding:56px 100px 64px"],
    #design [style*="padding:44px 60px 30px"]{
      padding-left:clamp(20px,5vw,60px)!important;padding-right:clamp(20px,5vw,60px)!important}
  }
  /* The artboard's flex rows are authored nowrap at 1440px; their min-content
     was propping the hero grid track open to 434px inside a 375px screen. */
  @media (max-width:900px){
    #design [style*="display:flex"]{flex-wrap:wrap!important}
    #design [style*="display:grid"] > *{min-width:0}
    #design [style*="gap:54px"]{gap:clamp(10px,3.4vw,24px)!important}
    #design [style*="gap:80px"]{gap:clamp(24px,5vw,44px)!important}
    #design [style*="white-space:nowrap"]{white-space:normal!important}
  }
  @media (max-width:720px){
    #design [style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important}
    #design [style*="font-size:62px"]{font-size:clamp(32px,8vw,50px)!important}
    #design [style*="font-size:44px"]{font-size:clamp(26px,6.4vw,38px)!important}
    #design [style*="height:680px"]{height:clamp(280px,62vw,520px)!important}
  }

  /* The artboard carries its hover states in `style-hover` attributes, which are
     a design-tool convention the browser ignores — every control on the page was
     inert. These restore the specced states against the shapes they apply to. */
  #design a[style*="border-radius:999px"]{will-change:transform}
  #design a[style*="border-radius:999px"]:hover{
    transform:translateY(-3px);filter:brightness(1.09);
    box-shadow:0 18px 44px rgba(43,38,32,.38),inset 0 1px 1px rgba(255,255,255,.65),
               inset 0 -1px 1px rgba(43,38,32,.12)}
  #design a[style*="border-bottom:1px solid rgba(138,122,94"]:hover{
    color:#7B3F2E;border-bottom-color:#B08D57}
  #design a[style*="transition:color"]:hover{color:#7B3F2E}
  #design [style*="backdrop-filter"][style*="border-radius:16px"]:hover,
  #design [style*="backdrop-filter"][style*="border-radius:14px"]:hover{
    transform:translateY(-4px);box-shadow:0 16px 36px rgba(43,38,32,.2)}
  #design [style*="backdrop-filter"][style*="border-radius:16px"],
  #design [style*="backdrop-filter"][style*="border-radius:14px"]{
    transition:transform .22s ease,box-shadow .22s ease}
  @media (prefers-reduced-motion:reduce){
    #design a[style*="border-radius:999px"]:hover,
    #design [style*="backdrop-filter"]:hover{transform:none}
  }

  /* ---- splash: the setter, turning ---- */
  #splash{position:fixed;inset:0;z-index:60;background:#F0EAD9 url('/memorials/papyrus.svg') center/cover;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:clamp(14px,2.6vh,30px);transition:opacity .9s ease,visibility .9s ease}
  #splash.done{opacity:0;visibility:hidden}
  .brandname{font-size:clamp(21px,2.6vw,34px);font-weight:600;
    letter-spacing:clamp(7px,1.1vw,14px);color:#8A7A5E;text-indent:clamp(7px,1.1vw,14px)}
  .brandsub{font-family:'Cormorant Garamond',serif;font-size:clamp(13px,1.5vw,21px);
    letter-spacing:6px;color:#8A7A5E;opacity:.75;margin-top:8px;text-indent:6px}
  /* Turntable sprite sheet, driven from JS so the frame rate is one number to
     tune. 24 frames over 9s read as ~2.7fps and stepped visibly; 60 frames at
     12fps is a smooth 5s revolution. Geometry constants live on the element so
     the CSS and the script cannot disagree. */
  #spin{width:clamp(210px,30vw,340px);
    background-image:url('/memorials/setter_turntable.webp');
    background-repeat:no-repeat;
    filter:drop-shadow(0 24px 28px rgba(118,92,58,.28));
    opacity:0;animation:fade-in .9s .3s ease forwards}
  @keyframes fade-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  #splash .rule{width:120px;height:2px;background:#B08D57;transform:scaleX(0);
    animation:draw 2.6s .8s cubic-bezier(.4,0,.2,1) forwards}
  @keyframes draw{to{transform:scaleX(1)}}
  #splash .tag{font-style:italic;color:#8A7A5E;font-size:clamp(16px,2vw,27px);
    text-align:center;padding:0 22px;opacity:0;animation:fade-in .9s .62s ease forwards}
  #splash .lockup{text-align:center;opacity:0;animation:fade-in .9s .12s ease forwards}

  @media (prefers-reduced-motion:reduce){
    #spin{animation:none;opacity:1}
    #splash .rule{animation:none;transform:scaleX(1)}
    #splash .tag,#splash .lockup{animation:none;opacity:1}
    #splash{transition:none}
    #design [style*="animation"]{animation:none!important}
  }
</style>
</head>
<body>

<div id="splash">
  <div class="lockup">
    <div class="brandname">DASH CREATIVES</div>
    <div class="brandsub">MEMORIAL ART STUDIO</div>
  </div>
  <div id="spin" role="img" aria-label="A sculpted English Setter, turning slowly"></div>
  <div class="rule"></div>
  <div class="tag">Sculpting the Memory of your Beloved Pet</div>
</div>

