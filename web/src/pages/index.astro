---
// DASH Creatives gateway — five eggs nested in fog.
//
// Replaced the three.js diamond-heart ritual (heart → shatter → 3D eggs) with a
// pure-CSS environment: no canvas, no /gateway/three.min.js (603 KB off the
// landing page). Assets still live in public/gateway/ for the worlds below.
//
// Two behaviours from the old gateway are load-bearing and survive intact:
//   1. LamarCy does NOT navigate — it reveals #rest (LamarCyWorld) in place.
//      Its href is the real /?world=lamarcy URL so it still works without JS
//      and on middle-click; JS intercepts a plain click to skip the reload.
//   2. /?world=lamarcy[#hash] bypasses the gateway outright. Checkout return
//      trips and the IG bio depend on it, and it carries ?s= attribution.
import LamarCyWorld from '../components/LamarCyWorld.astro';
import OrbNav from '../components/OrbNav.astro';
import MediaGuard from '../components/MediaGuard.astro';

// Copy is verbatim from the previous .egglabels overlay.
const WORLDS = [
  { cls: 'pink',   href: '/art/#gallery',                who: 'D.LAMAR',        role: 'The Painter',    line: 'The Works',                        photo: '/gateway/note-dlamar.webp',  baked: true },
  { cls: 'blue',   href: '/?world=lamarcy',              who: 'LamarCy',        role: 'The Songwriter', line: 'The Music',                     inPage: true, photo: '/gateway/note-lamarcy.webp', baked: true },
  { cls: 'yellow', href: '/art/#music',                  who: 'Ashley Smith',   role: 'The Voice',      line: 'her songs & stories',              photo: '/gateway/note-blank-a.webp' },
  { cls: 'green',  href: 'https://ux.dashcreatives.art', who: 'Durrell Smith',  role: 'UX Design',      line: 'the design work',                  photo: '/gateway/note-blank-b.webp' },
  { cls: 'rust',   href: '/memorials',                   who: 'Original Dogman', role: 'The Sculptor',  line: 'one-of-one sculptures and wearable art', logo: '/gateway/logo-dogman.webp', photo: '/gateway/note-blank-c.webp' },
];
---
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DASH Creatives — Pick a World</title>
<meta name="description" content="LamarCy is the songwriter half of DASH Creatives — Southern blues, soul, and rock written in Atlanta, haunted by Charleston.">
<style is:global>
/* Gateway-only chrome. Base tokens, type roles and every world style live in
   LamarCyWorld.astro, which this page renders inside #rest. */

/* Self-hosted like Oswald/Anton — the landing page should not wait on a
   third-party font request, and a failed load would drop the handwriting to
   a system cursive that looks nothing like a marker.
   Rock Salt is a stand-in for Durrell's own hand: disconnected print, bouncing
   letter heights, blunt marker stroke. Replace with the real Calligraphr build
   when that TTF exists — only the src and the two font-size rules change. */
@font-face{font-family:'DashHand';src:url('/gateway/RockSalt.ttf');font-display:swap}

/* ---------- the fog environment ---------- */
/* No floor, no ceiling, no horizon — the gradient is radial so it reads as
   depth in every direction rather than a room. */
#hero{
  position:relative;height:100vh;min-height:640px;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  /* Falloff is steeper than a flat wash: white fog only reads as fog if the
     ground behind it is meaningfully darker at the edges. */
  background:radial-gradient(ellipse 110% 95% at 50% 42%,
    #fafaf9 0%, #f3f3f1 26%, #ebebe8 48%, #e0e0dc 74%, #d4d4cf 100%);
}

/* Fog layers never intercept a click — every egg link stays reachable. */
#hero .fog,#hero .fog span,#hero .band{pointer-events:none}

#hero .fog{position:absolute;inset:-12%;z-index:1}
#hero .fog span{
  position:absolute;border-radius:50%;
  background:radial-gradient(ellipse at 50% 50%, rgba(255,255,255,.9) 0%,
    rgba(255,255,255,.62) 42%, rgba(255,255,255,0) 72%);
  filter:blur(44px);opacity:.9;will-change:transform;
}
#hero .fog .f1{width:58vw;height:38vh;left:-6%;top:12%;animation:drift-a 29s ease-in-out infinite}
#hero .fog .f2{width:46vw;height:30vh;right:-8%;top:26%;animation:drift-b 36s ease-in-out infinite}
#hero .fog .f3{width:64vw;height:34vh;left:14%;bottom:6%;animation:drift-a 24s ease-in-out infinite reverse}
#hero .fog .f4{width:38vw;height:26vh;left:30%;top:2%;animation:drift-b 31s ease-in-out infinite reverse}
/* .front sits above the eggs so the row feels submerged, not pasted on. */
#hero .fog.front{z-index:4}
#hero .fog.front span{filter:blur(50px);opacity:.75}
#hero .fog.front .g1{width:52vw;height:26vh;left:-10%;bottom:16%;animation:drift-b 27s ease-in-out infinite}
#hero .fog.front .g2{width:44vw;height:22vh;right:-12%;bottom:22%;animation:drift-a 33s ease-in-out infinite reverse}

/* A wide, soft band behind the row so the five eggs read as one bank of fog. */
#hero .band{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:min(1500px,96vw);height:300px;z-index:2;
  background:radial-gradient(ellipse at 50% 52%, rgba(255,255,255,.62) 0%,
    rgba(255,255,255,.34) 48%, rgba(255,255,255,0) 76%);
  filter:blur(44px);
}

@keyframes drift-a{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(6%,-2%,0)}}
@keyframes drift-b{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-7%,2%,0)}}

/* ---------- the row ---------- */
#hero .worlds{
  /* Five notes + four gaps + padding has to fit the viewport. At a fixed
     152px the row needed 875px, so anywhere from the 760px breakpoint up to
     ~880px the outer notes were clipped on both edges. */
  --nw:clamp(120px, 15.5vw, 152px);
  position:relative;z-index:3;
  display:flex;align-items:flex-start;justify-content:center;
  gap:clamp(14px,2.4vw,40px);
  list-style:none;margin:0;padding:0 24px;
  max-width:100%;
}
#hero .worlds li{flex:0 0 auto}

#hero .world{
  display:flex;flex-direction:column;align-items:center;
  width:var(--nw);text-decoration:none;
  border-radius:14px;padding:6px 4px 10px;
}
#hero .world:focus-visible{
  outline:3px solid #067874;outline-offset:6px;
  background:rgba(255,255,255,.55);
}

/* ---------- the sticky note ---------- */
/* Paper and fog are both light, so the note separates by hue and by its
   shadow, not by brightness — hence the fairly present drop shadow. */
#hero .eggwrap{position:relative;width:var(--nw);height:var(--nw);display:block}

#hero .note{
  position:absolute;inset:0;z-index:2;
  display:flex;align-items:center;justify-content:center;
  padding:12px 8px 16px;box-sizing:border-box;
  background:
    linear-gradient(196deg, rgba(255,255,255,.55) 0%, rgba(255,255,255,0) 34%),
    linear-gradient(170deg, #F6E9A0 0%, #F0E28A 56%, #E7D678 100%);
  box-shadow:0 16px 28px -10px rgba(104,96,48,.34),
             0 3px 8px rgba(104,96,48,.16),
             inset 0 1px 0 rgba(255,255,255,.5);
  animation:bob 9s ease-in-out infinite;
  will-change:transform;
}
/* A photographed note supplies its own paper, shadow and corner, so the
   painted ones are switched off — otherwise the CSS card shows behind the
   cut-out and doubles the shadow. */
#hero .note.is-photo{
  background:none;box-shadow:none;
  filter:drop-shadow(0 10px 18px rgba(104,96,48,.17));
}
#hero .note.is-photo::after{content:none}
/* The sheet leaves the flex flow and becomes a backdrop, so a header written
   on top centres over the paper instead of being pushed underneath it. */
/* Direct child only: a descendant selector also caught the logo inside .mark
   and absolutely positioned it, collapsing .mark to 7px tall. */
#hero .note.is-photo > img{
  position:absolute;inset:0;z-index:1;
  display:block;width:100%;height:100%;object-fit:contain;
}
/* Paper occupies roughly the top 90% of the frame — the strip below it is the
   contact shadow. Writing rides up so it lands on the sheet, not the shadow. */
#hero .note.is-photo .hand,
#hero .note.is-photo .mark{transform:translateY(-4%) rotate(-2deg)}

/* The lifted bottom-right corner from the reference photo. */
#hero .note::after{
  content:'';position:absolute;right:0;bottom:0;width:26px;height:22px;
  background:linear-gradient(135deg, rgba(0,0,0,0) 46%, rgba(160,150,90,.30) 52%, #F7EFAE 56%);
  border-bottom-right-radius:2px;
  box-shadow:-3px -3px 6px rgba(104,96,48,.16);
}
/* Pinned by hand, so none of them sit perfectly square. */
#hero li:nth-child(1) .eggwrap{transform:rotate(-2.4deg)}
#hero li:nth-child(2) .eggwrap{transform:rotate(1.6deg)}
#hero li:nth-child(3) .eggwrap{transform:rotate(-1deg)}
#hero li:nth-child(4) .eggwrap{transform:rotate(2.2deg)}
#hero li:nth-child(5) .eggwrap{transform:rotate(-1.8deg)}

/* A brand mark in place of handwriting — same optical slot, same tilt, so it
   still reads as something set down on the paper rather than a logo pasted on
   top. Width is capped off --nw so it scales with the note. */
#hero .mark{
  position:relative;z-index:2;display:block;width:82%;transform:rotate(-2deg);
}
#hero .mark img{display:block;width:100%;height:auto}

/* The header, written on the note. */
#hero .hand{
  position:relative;z-index:2;text-align:center;
  font-family:'DashHand',cursive;line-height:1.28;
  transform:rotate(-2deg);
}
/* nowrap keeps the longest name ('Durrell Smith') on one line like the
   others — at 27px it was 132px inside 132px of usable width and broke. */
#hero .hand .who{display:block;font-size:calc(var(--nw) * .099);letter-spacing:0;white-space:nowrap}
#hero .hand .role{display:block;font-size:calc(var(--nw) * .069);margin-top:calc(var(--nw) * .059);opacity:.85;white-space:nowrap}

/* Staggered so the five never rise together. */
#hero li:nth-child(1) .note{animation-duration:9.5s;animation-delay:-.2s}
#hero li:nth-child(2) .note{animation-duration:11s;animation-delay:-2.4s}
#hero li:nth-child(3) .note{animation-duration:8.4s;animation-delay:-4.1s}
#hero li:nth-child(4) .note{animation-duration:10.3s;animation-delay:-1.3s}
#hero li:nth-child(5) .note{animation-duration:9s;animation-delay:-3.5s}
@keyframes bob{0%,100%{transform:translate3d(0,8px,0)}50%{transform:translate3d(0,-8px,0)}}

/* Cloud BEHIND the egg — wider than the egg, so it sits in a bank. */
#hero .c-back{
  position:absolute;z-index:1;left:-38%;right:-38%;top:20%;height:78%;
  background:radial-gradient(ellipse at 50% 58%, rgba(255,255,255,1) 0%,
    rgba(255,255,255,.82) 38%, rgba(255,255,255,.3) 62%, rgba(255,255,255,0) 80%);
  filter:blur(22px);pointer-events:none;
}
/* Cloud IN FRONT — covers roughly the lower third, fading out upward, so the
   top two-thirds of every egg stays clearly visible. */
#hero .c-front{
  /* Shallower than the egg version: the header is written ON the note now, so
     the veil only touches the bottom edge and never reaches the ink. */
  position:absolute;z-index:3;left:-30%;right:-30%;bottom:-12%;height:30%;
  background:linear-gradient(to top, rgba(255,255,255,.98) 0%,
    rgba(255,255,255,.78) 34%, rgba(255,255,255,.34) 68%, rgba(255,255,255,0) 100%);
  filter:blur(14px);pointer-events:none;
}
/* One small wisp crossing each egg. */
#hero .wisp{
  position:absolute;z-index:3;left:-40%;width:78%;height:14%;top:74%;
  background:radial-gradient(ellipse at 50% 50%, rgba(255,255,255,.8) 0%,
    rgba(255,255,255,.42) 46%, rgba(255,255,255,0) 78%);
  filter:blur(12px);pointer-events:none;
  animation:wisp 26s linear infinite;will-change:transform;
}
#hero li:nth-child(2) .wisp{top:70%;animation-duration:31s;animation-delay:-8s}
#hero li:nth-child(3) .wisp{top:78%;animation-duration:22s;animation-delay:-14s}
#hero li:nth-child(4) .wisp{top:72%;animation-duration:35s;animation-delay:-4s}
#hero li:nth-child(5) .wisp{top:76%;animation-duration:28s;animation-delay:-19s}
@keyframes wisp{0%{transform:translate3d(0,0,0)}100%{transform:translate3d(220%,0,0)}}

/* ---------- labels ---------- */
/* Above every fog layer so the copy is never veiled. Hues are the original
   world colours, darkened only as far as WCAG AA (4.5:1) required against the
   fog — see the note in the commit. */
#hero .lbl{
  position:relative;z-index:6;margin-top:18px;text-align:center;
}
#hero .lbl .ln{
  display:block;font-family:'Oswald',sans-serif;text-transform:uppercase;
  font-size:11px;letter-spacing:4px;font-weight:400;
  color:#3d3b36;line-height:1.5;
}
/* Marker ink keeps each world's colour, darkened only as far as WCAG AA
   needed against the paper (the reference note used one dark pen; colour is
   what preserves the world coding). */
#hero .pink   .hand{color:#B22F5B}
#hero .blue   .hand{color:#066E6B}
#hero .yellow .hand{color:#785906}
#hero .green  .hand{color:#2E6A38}
#hero .rust   .hand{color:#7B3F2E}

/* ---------- mobile: swipe the row ---------- */
@media (max-width:760px){
  #hero .worlds{
    justify-content:flex-start;
    overflow-x:auto;overflow-y:hidden;
    scroll-snap-type:x proximity;
    -webkit-overflow-scrolling:touch;
    overscroll-behavior-x:contain;      /* never turns into page-level sideways scroll */
    /* Gap is wider here than on desktop on purpose: it cuts the third egg to
       roughly half, so the row visibly continues past the fold. */
    gap:34px;
    padding:0 20px;
    scrollbar-width:none;
  }
  #hero .worlds::-webkit-scrollbar{display:none}
  #hero .worlds li{scroll-snap-align:center}
  #hero .worlds{--nw:118px}
  /* 12px spilled 'Durrell Smith' past the paper edge at 118px notes. */
  #hero .hand .who{font-size:11px}
  #hero .hand .role{font-size:8px;margin-top:6px}
  #hero .band{height:230px}
  /* ~2.5 eggs in view, so it reads as scrollable */
  #hero .lbl .ln{font-size:10px;letter-spacing:2px}
}
html,body{max-width:100%;overflow-x:hidden}

@media (prefers-reduced-motion:reduce){
  #hero .fog span,#hero .note,#hero .wisp{animation:none!important}
}

body.locked{overflow:hidden;height:100vh}
#veil{position:fixed;inset:0;background:var(--ink);opacity:0;pointer-events:none;transition:opacity .55s ease;z-index:50}
#veil.on{opacity:1;pointer-events:auto}
#rest{display:none}
</style>
</head>
<body class="locked">

<!-- ============ GATEWAY: five eggs in fog ============ -->
<div id="veil"></div>
<div id="hero">
  <div class="fog" aria-hidden="true"><span class="f1"></span><span class="f2"></span><span class="f3"></span><span class="f4"></span></div>
  <div class="band" aria-hidden="true"></div>

  <ul class="worlds" id="worlds">
    {WORLDS.map((w) => (
      <li>
        <a class={`world ${w.cls}`} href={w.href} data-inpage={w.inPage ? 'true' : undefined}
           aria-label={`${w.who} · ${w.role} — ${w.line}`}>
          <span class="eggwrap">
            <span class="c-back" aria-hidden="true"></span>
            {/* Every note is now Durrell's own photographed sheet. The first two
                were shot already lettered, so `baked` suppresses the overlay;
                the rest take the blank sheet with the header written on top. */}
            <span class={w.photo ? 'note is-photo' : 'note'}>
              {w.photo && <img src={w.photo} alt="" width="366" height="380" decoding="async" />}
              {!w.baked && (w.logo
                ? <span class="mark"><img src={w.logo} alt="" width="520" height="200" decoding="async" /></span>
                : <span class="hand"><span class="who">{w.who}</span><span class="role">{w.role}</span></span>
              )}
            </span>
            <span class="wisp" aria-hidden="true"></span>
            <span class="c-front" aria-hidden="true"></span>
          </span>
          <span class="lbl"><span class="ln" set:html={w.line}></span></span>
        </a>
      </li>
    ))}
  </ul>

  <div class="fog front" aria-hidden="true"><span class="g1"></span><span class="g2"></span></div>
</div>

<div id="rest">
<LamarCyWorld />
</div><!-- /rest -->

<OrbNav />
<MediaGuard />

<script is:inline>
(function(){
  function openWorld(){
    document.getElementById('hero').style.display = 'none';
    document.getElementById('rest').style.display = 'block';
    document.body.classList.remove('locked');
    window.scrollTo(0,0);
    setTimeout(()=>document.getElementById('veil').classList.remove('on'), 120);
  }

  // Deep link: /?world=lamarcy[#singles] skips the gateway (checkout return
  // trips, IG bio). Must run before anything else binds.
  if (new URLSearchParams(location.search).get('world') === 'lamarcy') {
    openWorld();
    var target = location.hash && document.querySelector(location.hash);
    if (target) setTimeout(function(){ target.scrollIntoView(); }, 200);
    return;
  }

  var veil = document.getElementById('veil');

  document.querySelectorAll('#worlds .world').forEach(function(a){
    a.addEventListener('click', function(e){
      // Leave modified clicks alone — cmd/ctrl/shift/middle-click must still
      // open a new tab or window the way the browser intends.
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      if (a.dataset.inpage === 'true'){        // LamarCy lives below the gate
        e.preventDefault();
        openWorld();
        return;
      }
      e.preventDefault();                       // brief veil, then travel
      veil.classList.add('on');
      var href = a.getAttribute('href');
      setTimeout(function(){ window.location.href = href; }, 380);
    });
  });
})();
</script>

</body>
</html>
