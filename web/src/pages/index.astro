        <div class="playrow">
          <button class="pbtn" type="button" data-sku="momma" aria-label="Play Momma Gone">▶</button>
          <div class="pbar"><div class="pfill"></div></div>
          <div class="ptime">0:00 / 0:00</div>
        </div>
        <div class="buyrow">
          <button class="cta buy" type="button" data-sku="momma">Own it · $0.99+</button>
          <a class="cta" href="https://lamarcy.bandcamp.com" target="_blank" rel="noopener">Hear it on Bandcamp</a>
        </div>
        <div class="buynote">MP3 · Pay what you want from $0.99 · Checkout by Stripe</div>
        <div class="buyerr"></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ THE CHRONICLE ============ -->
<section class="block" id="chronicle">
  <div class="kick">Follow the Making</div>
  <h2 style="color:var(--cream)">The Chronicle</h2>
  <p class="lede">The music is documented as it&rsquo;s made — essays, gear breakdowns, and the
     story of every song. Pick a door.</p>
  <div class="doors">
    <a class="door" href="https://substack.com/@lamarcy3" target="_blank" rel="noopener">
      <div class="d1">Substack</div><div class="d2">The essays · one song, one story</div></a>
    <a class="door" href="https://lamarcy.bandcamp.com" target="_blank" rel="noopener">
      <div class="d1">Bandcamp</div><div class="d2">Own the music</div></a>
    <a class="door" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="d1">Instagram</div><div class="d2">The daily chronicle</div></a>
    <a class="door" href="https://www.youtube.com/@durrelllamar" target="_blank" rel="noopener">
      <div class="d1">YouTube</div><div class="d2">Anatomy of every song</div></a>
  </div>
</section>

<footer>
  <img src="/gateway/wordmark.png" alt="LamarCy">
  <div class="mono">LamarCy · The Yin to D.LAMAR&rsquo;s Yang · Atlanta, GA · CHS→ATL</div>
</footer>

</div><!-- /rest -->

<!-- ============ 3D DIAMOND HEART · click to crack & shatter ============ -->
<script is:inline src="/gateway/three.min.js"></script>
<script is:inline>
(function(){
  // ------- destinations (EDIT THESE) -------
  const DEST = {
    pink:   '/art/#gallery',    // D.LAMAR · the current dashcreatives.art site, relocated to /art/
    blue:   'WORLD',            // LamarCy · the music world below
    yellow: '/art/#music',      // Ashley Smith · TODO: her own page/channel
    green:  '/art/#about'       // Durrell Smith UX design · TODO: portfolio URL
  };

  function openWorld(){
    document.getElementById('hero').style.display = 'none';
    document.getElementById('rest').style.display = 'block';
    document.body.classList.remove('locked');
    window.scrollTo(0,0);
    setTimeout(()=>document.getElementById('veil').classList.remove('on'), 120);
  }
  // Deep link: /?world=lamarcy[#singles] skips the ritual (checkout return trips, IG bio)
  if (new URLSearchParams(location.search).get('world') === 'lamarcy') {
    openWorld();
    const target = location.hash && document.querySelector(location.hash);
    if (target) setTimeout(() => target.scrollIntoView(), 200);
    return;
  }
  if (!window.THREE) { document.getElementById('heartCanvas').outerHTML =
    '<img src="/gateway/heart.png" style="position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);width:min(46vw,420px);z-index:3;cursor:pointer" alt="LamarCy heart" id="fbheart">';
    document.getElementById('fbheart').onclick = openWorld; return; }

  const canvas = document.getElementById('heartCanvas');
  const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.outputEncoding = THREE.sRGBEncoding;
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(38, 1, .1, 400);
  camera.position.set(0, 0, 55);

  function heartShape(s){
    const sh = new THREE.Shape();
    sh.moveTo(0, -6.5*s);
    sh.bezierCurveTo( 8.6*s, -0.5*s,  7.4*s, 7.6*s,  0, 3.4*s);
    sh.bezierCurveTo(-7.4*s, 7.6*s, -8.6*s, -0.5*s,  0, -6.5*s);
    return sh;
  }
  function dotCanvas(bg, dot){
    const c = document.createElement('canvas'); c.width = c.height = 512;
    const g = c.getContext('2d');
    g.fillStyle = bg; g.fillRect(0,0,512,512);
    g.fillStyle = dot;
    const step = 40;
    for (let y=0; y<512+step; y+=step)
      for (let x=0; x<512+step; x+=step){
        const ox = (Math.floor(y/step)%2) ? step/2 : 0;
        g.beginPath(); g.arc(x+ox, y, 10.5, 0, Math.PI*2); g.fill();
      }
    return c;
  }
  function drawCracksOn(cv, tex, n){
    const g = cv.getContext('2d');
    g.strokeStyle = '#141412'; g.lineWidth = 5; g.lineCap='round';
    for (let i=0;i<n;i++){
      let x = 100+Math.random()*312, y = 60+Math.random()*392;
      g.beginPath(); g.moveTo(x,y);
      for (let k=0;k<5;k++){ x += (Math.random()-.5)*110; y += (Math.random()-.5)*110; g.lineTo(x,y); }
      g.stroke();
    }
    tex.needsUpdate = true;
  }

  // ------- the diamond heart -------
  const heartDots = dotCanvas('#09B1AB','rgba(6,122,118,0.95)');
  const heartTex = new THREE.CanvasTexture(heartDots);
  heartTex.encoding = THREE.sRGBEncoding;
  heartTex.wrapS = heartTex.wrapT = THREE.RepeatWrapping; heartTex.repeat.set(.052,.052);
  const geo = new THREE.ExtrudeGeometry(heartShape(1), {depth:3.4, bevelEnabled:true,
    bevelThickness:2.6, bevelSize:2.2, bevelSegments:2, curveSegments:7});
  geo.center();
  const heartMat = new THREE.MeshPhysicalMaterial({map:heartTex, flatShading:true, metalness:.35,
    roughness:.22, clearcoat:1, clearcoatRoughness:.12, emissive:0x063f3c, emissiveIntensity:.1});
  const heart = new THREE.Mesh(geo, heartMat);
  const group = new THREE.Group(); group.add(heart); scene.add(group);

  new THREE.TextureLoader().load('/gateway/mannish-boy.jpg', function(tex){
    tex.encoding = THREE.sRGBEncoding;
    const pGeo = new THREE.ShapeGeometry(heartShape(0.72), 24);
    pGeo.computeBoundingBox();
    const bb = pGeo.boundingBox, sz = new THREE.Vector3(); bb.getSize(sz);
    const pos = pGeo.attributes.position, uvs = [];
    const ar = tex.image.width/tex.image.height, br = sz.x/sz.y;
    for (let i=0;i<pos.count;i++){
      let u=(pos.getX(i)-bb.min.x)/sz.x, v=(pos.getY(i)-bb.min.y)/sz.y;
      if (ar>br){ u=.5+(u-.5)*(br/ar);} else { v=.5+(v-.5)*(ar/br);}
      uvs.push(u,v);
    }
    pGeo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs,2));
    pGeo.center();
    const pMesh = new THREE.Mesh(pGeo, new THREE.MeshBasicMaterial({map:tex}));
    pMesh.position.set(0,0,4.40);
    const ring = new THREE.Mesh(new THREE.ShapeGeometry(heartShape(0.78),24),
      new THREE.MeshBasicMaterial({color:0x141412}));
    ring.geometry.center(); ring.position.set(0,0,4.34);
    group.add(ring); group.add(pMesh);
  });

  scene.add(new THREE.AmbientLight(0xf7f3e8,.5));
  const key = new THREE.DirectionalLight(0xffffff,2.2); key.position.set(6,8,10); scene.add(key);
  const rim = new THREE.DirectionalLight(0x5CB9AE,1.4); rim.position.set(-8,-4,6); scene.add(rim);
  const back = new THREE.DirectionalLight(0x09B1AB,.9); back.position.set(0,4,-8); scene.add(back);

  // ------- four eggs -------
  const EGGS = [
    {key:'pink',   x:-17, shell:'#F2A9C4', dot:'rgba(216,33,90,0.55)',  yolk:0xE0447E},
    {key:'blue',   x:-5.7,shell:'#09B1AB', dot:'rgba(6,122,118,0.95)',  yolk:0x067A76},
    {key:'yellow', x:5.7, shell:'#F4C531', dot:'rgba(199,147,18,0.75)', yolk:0xE8A317},
    {key:'green',  x:17,  shell:'#58B368', dot:'rgba(46,125,66,0.75)',  yolk:0x2E7D42}
  ];
  const eggMeshes = [];
  const eggGeo = new THREE.SphereGeometry(4.3, 28, 22); eggGeo.scale(1,1.35,1);
  for (const e of EGGS){
    const cv = dotCanvas(e.shell, e.dot);
    const t = new THREE.CanvasTexture(cv); t.encoding = THREE.sRGBEncoding;
    t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(2,2);
    const m = new THREE.Mesh(eggGeo, new THREE.MeshPhysicalMaterial({map:t, metalness:.15,
      roughness:.3, clearcoat:1, clearcoatRoughness:.15}));
    m.position.set(e.x, 0.4, 0);
    m.scale.setScalar(0.001); m.visible = false;
    m.userData = {cfg:e, canvas:cv, tex:t, baseX:e.x};
    scene.add(m); eggMeshes.push(m);
  }

  // ------- state -------
  let state = 'idle', t = 0, crackT = 0, shatterT = 0, eggCrackT = 0, spillT = 0;
  const clock = new THREE.Clock();
  const shards = [];
  let chosen = null, spillParts = null;

  function shatter(){
    group.visible = false;
    const shardMat = heartMat.clone();
    for (let i=0;i<56;i++){
      const sh = new THREE.Mesh(new THREE.TetrahedronGeometry(.35+Math.random()*1.1), shardMat);
      sh.position.set((Math.random()-.5)*10, (Math.random()-.5)*10, (Math.random()-.5)*4);
      sh.userData.v = new THREE.Vector3((Math.random()-.5)*.45, (Math.random()-.2)*.4, (Math.random()-.5)*.3);
      sh.userData.r = new THREE.Vector3(Math.random()*.2, Math.random()*.2, Math.random()*.2);
      scene.add(sh); shards.push(sh);
    }
    for (const m of eggMeshes) m.visible = true;
    document.getElementById('egglabels').style.display = 'block';
    setTimeout(()=>{ for (const id of ['lblPink','lblBlue','lblYellow','lblGreen'])
      document.getElementById(id).style.opacity = 1; }, 700);
    const hint = document.getElementById('hint');
    hint.textContent = '❤ pick a world';
  }

  function choose(key){
    if (state !== 'eggs') return;
    chosen = eggMeshes.find(m => m.userData.cfg.key === key);
    if (!chosen) return;
    state = 'eggcrack'; eggCrackT = 0;
    drawCracksOn(chosen.userData.canvas, chosen.userData.tex, 3);
    for (const id of ['lblPink','lblBlue','lblYellow','lblGreen'])
      document.getElementById(id).style.opacity = .25;
    document.getElementById('hint').style.opacity = 0;
  }

  function spill(){
    state = 'spill'; spillT = 0;
    const cfg = chosen.userData.cfg, px = chosen.position.x, py = chosen.position.y;
    chosen.visible = false;
    const shellMat = chosen.material;
    const topG = new THREE.SphereGeometry(4.3, 28, 12, 0, Math.PI*2, 0, Math.PI/2); topG.scale(1,1.35,1);
    const botG = new THREE.SphereGeometry(4.3, 28, 12, 0, Math.PI*2, Math.PI/2, Math.PI/2); botG.scale(1,1.35,1);
    const top = new THREE.Mesh(topG, shellMat), bot = new THREE.Mesh(botG, shellMat);
    top.position.set(px, py, 0); bot.position.set(px, py, 0);
    const yolkMat = new THREE.MeshPhysicalMaterial({color:cfg.yolk, roughness:.15, clearcoat:1, clearcoatRoughness:.08});
    const yolk = new THREE.Mesh(new THREE.SphereGeometry(2.6, 20, 16), yolkMat);
    yolk.position.set(px, py, 4.5);
    const drops = [];
    for (let i=0;i<9;i++){
      const d = new THREE.Mesh(new THREE.SphereGeometry(.3+Math.random()*.5, 10, 8), yolkMat);
      d.position.set(px+(Math.random()-.5)*3, py-1-Math.random()*1.5, 4.2+(Math.random()-.5));
      d.userData.v = new THREE.Vector3((Math.random()-.5)*.12, -.1-Math.random()*.15, 0);
      drops.push(d); scene.add(d);
    }
    scene.add(top, bot, yolk);
    spillParts = {top, bot, yolk, drops, px, py};
    setTimeout(()=>document.getElementById('veil').classList.add('on'), 1250);
    setTimeout(()=>{
      const dest = DEST[cfg.key];
      if (dest === 'WORLD') openWorld();
      else window.location.href = dest;
    }, 2000);
  }

  // ------- input -------
  const ray = new THREE.Raycaster(), mouse = new THREE.Vector2();
  function hit(e, targets){
    const r = canvas.getBoundingClientRect();
    mouse.x = ((e.clientX-r.left)/r.width)*2-1;
    mouse.y = -((e.clientY-r.top)/r.height)*2+1;
    ray.setFromCamera(mouse, camera);
    const res = ray.intersectObjects(targets, true);
    return res.length ? res[0].object : null;
  }
  canvas.style.pointerEvents = 'auto';
  canvas.addEventListener('pointermove', e => {
    const over = (state==='idle' && hit(e,[heart])) || (state==='eggs' && hit(e, eggMeshes));
    canvas.style.cursor = over ? 'pointer' : 'default';
  });
  canvas.addEventListener('click', e => {
    if (state==='idle' && hit(e,[heart])){ state='cracking'; crackT=0; drawCracksOn(heartDots, heartTex, 3); }
    else if (state==='eggs'){
      const m = hit(e, eggMeshes);
      if (m) choose(m.userData.cfg.key);
    }
  });
  for (const [id,key] of [['lblPink','pink'],['lblBlue','blue'],['lblYellow','yellow'],['lblGreen','green']]){
    const el = document.getElementById(id);
    el.style.pointerEvents='auto'; el.style.cursor='pointer';
    el.onclick = ()=>choose(key);
  }

  function size(){
    renderer.setSize(innerWidth, innerHeight, false);
    camera.aspect = innerWidth/innerHeight;
    camera.position.z = camera.aspect < 1 ? Math.min(55/camera.aspect*0.85, 95) : 55;
    camera.updateProjectionMatrix();
  }
  addEventListener('resize', size); size();

  (function loop(){
    requestAnimationFrame(loop);
    const dt = Math.min(clock.getDelta(), .1);
    t += dt * .5;

    if (state==='idle' || state==='cracking'){
      group.rotation.y = t;
      group.rotation.x = Math.sin(t*.6)*.08;
      group.position.y = -0.5 + Math.sin(t*1.3)*.35;
    }
    if (state==='cracking'){
      crackT += dt;
      group.position.x = (Math.random()-.5) * crackT * 1.6;
      group.position.y += (Math.random()-.5) * crackT * 1.2;
      if (crackT > .5 && crackT < .55) drawCracksOn(heartDots, heartTex, 3);
      if (crackT > 1.05 && crackT < 1.1) drawCracksOn(heartDots, heartTex, 4);
      if (crackT > 1.7){ state='shattering'; shatterT=0; shatter(); }
    }
    if (state!=='idle' && state!=='cracking'){
      for (const sh of shards){
        sh.position.addScaledVector(sh.userData.v, dt*60);
        sh.userData.v.y -= .012*dt*60;
        sh.rotation.x += sh.userData.r.x; sh.rotation.y += sh.userData.r.y;
        sh.scale.multiplyScalar(Math.pow(.975, dt*60));
      }
    }
    if (state==='shattering'){
      shatterT += dt;
      const k = Math.min(shatterT/1.1, 1), ease = 1-Math.pow(1-k,3);
      for (const m of eggMeshes) m.scale.setScalar(ease);
      if (k>=1) state='eggs';
    }
    if (state==='eggs' || state==='shattering'){
      for (let i=0;i<eggMeshes.length;i++){
        const m = eggMeshes[i];
        m.rotation.y += (i%2 ? -.012 : .012);
        m.position.y = 0.4 + Math.sin(t*1.5 + i*1.7)*.3;
      }
    }
    if (state==='eggcrack' && chosen){
      eggCrackT += dt;
      chosen.position.x = chosen.userData.baseX + (Math.random()-.5)*eggCrackT*2.2;
      chosen.position.y = 0.4 + (Math.random()-.5)*eggCrackT*1.8;
      if (eggCrackT > .35 && eggCrackT < .4) drawCracksOn(chosen.userData.canvas, chosen.userData.tex, 3);
      if (eggCrackT > .7 && eggCrackT < .75) drawCracksOn(chosen.userData.canvas, chosen.userData.tex, 4);
      for (const m of eggMeshes) if (m!==chosen) m.scale.multiplyScalar(Math.pow(.985, dt*60));
      if (eggCrackT > 1.0) spill();
    }
    if (state==='spill' && spillParts){
      spillT += dt;
      const P = spillParts;
      P.top.position.y += 9*dt; P.top.rotation.z += 1.6*dt; P.top.position.x += 3.5*dt;
      P.bot.position.y -= 3.5*dt; P.bot.rotation.z -= .8*dt; P.bot.position.x -= 2*dt;
      // yolk falls then squashes into a puddle
      if (P.yolk.position.y > P.py - 6.5){ P.yolk.position.y -= 10*dt; }
      else { P.yolk.scale.y = Math.max(P.yolk.scale.y - 2.2*dt, .35);
             P.yolk.scale.x = Math.min(P.yolk.scale.x + 2.6*dt, 2.1);
             P.yolk.scale.z = Math.min(P.yolk.scale.z + 2.6*dt, 2.1); }
      for (const d of P.drops){
        d.position.addScaledVector(d.userData.v, dt*60);
        d.userData.v.y -= .01*dt*60;
      }
    }
    renderer.render(scene, camera);
  })();
})();
</script>
<script is:inline>
// ---- THE LISTENING POST + DIRECT SALES ----------------------------------
// Players appear when a single's master is uploaded; Buy buttons appear when
// Stripe is also configured — so this ships dark, then lights up in stages.
(function(){
  const buttons = document.querySelectorAll('button.cta.buy');
  if (!buttons.length) return;
  const players = {};
  const fmt = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s/60) + ':' + String(s%60).padStart(2,'0'); };

  function initPlayer(card, sku){
    const row = card.querySelector('.playrow');
    if (!row || players[sku]) return;
    const btn = row.querySelector('.pbtn'), bar = row.querySelector('.pbar'),
          fill = row.querySelector('.pfill'), time = row.querySelector('.ptime');
    const audio = new Audio('/store/play?sku=' + sku + '&v=2');
    audio.preload = 'metadata';
    players[sku] = audio;
    row.style.display = 'flex';
    const paint = () => {
      fill.style.width = audio.duration ? (audio.currentTime / audio.duration * 100) + '%' : '0%';
      time.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
    };
    audio.addEventListener('loadedmetadata', paint);
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('play',  () => { btn.textContent = 'Ⅱ'; });
    audio.addEventListener('pause', () => { btn.textContent = '▶'; });
    audio.addEventListener('ended', () => { btn.textContent = '▶'; paint(); });
    btn.addEventListener('click', () => {
      if (audio.paused){
        for (const k in players) if (k !== sku) players[k].pause();
        audio.play().catch(()=>{});
      } else audio.pause();
    });
    bar.addEventListener('click', e => {
      if (!isFinite(audio.duration) || !audio.duration) return;
      const r = bar.getBoundingClientRect();
      audio.currentTime = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1) * audio.duration;
    });
  }

  fetch('/store/status').then(r => r.ok ? r.json() : null).then(s => {
    if (!s) return;
    for (const btn of buttons){
      const sku = btn.dataset.sku, card = btn.closest('.song');
      if (s.files && s.files[sku] && card) initPlayer(card, sku);
      if (s.ready && s.ready[sku]){
        btn.style.display = 'inline-block';
        const note = btn.closest('.body').querySelector('.buynote');
        if (note) note.style.display = 'block';
      }
    }
  }).catch(()=>{ /* store stays dark */ });

  for (const btn of buttons){
    btn.addEventListener('click', async () => {
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Opening checkout…';
      try {
        const r = await fetch('/store/checkout', {
          method: 'POST',
          headers: {'content-type':'application/json'},
          body: JSON.stringify({ sku: btn.dataset.sku })
        });
        const data = await r.json();
        if (data && data.ok && data.url){ location.href = data.url; return; }
        throw new Error((data && data.error) || 'checkout_failed');
      } catch (err){
        btn.disabled = false; btn.textContent = label;
        const errEl = btn.closest('.body').querySelector('.buyerr');
        if (errEl){ errEl.textContent = 'Checkout could not open — please try again in a minute.'; errEl.style.display = 'block'; }
      }
    });
  }
})();
</script>
<script is:inline>
// ---- LIVE INSTAGRAM FEED ----------------------------------------------
// To make these boxes auto-update with the latest LamarCy Instagram posts:
// 1. Create a free feed at https://behold.so (connect the Instagram account)
// 2. Paste the JSON feed URL it gives you below, e.g. 'https://feeds.behold.so/XXXX'
// The boxes then always show the newest posts — no code changes ever again.
const IG_FEED_URL = '';   // <— paste feed URL here
if (IG_FEED_URL) {
  fetch(IG_FEED_URL).then(r => r.json()).then(data => {
    const posts = (data.posts || data).slice(0, 6);
    const boxes = document.querySelectorAll('#igrid .igbox');
    posts.forEach((post, i) => {
      if (!boxes[i]) return;
      const img = post.thumbnailUrl || post.mediaUrl || post.sizes?.medium?.mediaUrl;
      if (!img) return;
      boxes[i].href = post.permalink || boxes[i].href;
      boxes[i].querySelector('.ph').innerHTML =
        '<img class="igimg" loading="lazy" alt="Instagram post" src="' + img + '">';
    });
  }).catch(()=>{ /* placeholders remain */ });
}
</script>
