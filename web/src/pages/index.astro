---
// DASH Creatives gateway — diamond heart → four eggs → worlds
// Assets live in public/gateway/ (unprocessed static files, per Astro convention)
---
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DASH Creatives — Pick a World</title>
<meta name="description" content="LamarCy is the songwriter half of DASH Creatives — Southern blues, soul, and rock written in Atlanta, haunted by Charleston.">
<style is:global>
@font-face{font-family:'Anton';src:url('/gateway/Anton.ttf')}
@font-face{font-family:'Oswald';src:url('/gateway/Oswald.ttf')}
:root{--tiffany:#09B1AB;--seafoam:#5CB9AE;--cream:#F7F3E8;--ink:#141412;--red:#D82128;--sepia:#E3DECB}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--cream);color:var(--ink);font-family:Georgia,'Times New Roman',serif}
.anton{font-family:'Anton',sans-serif;text-transform:uppercase}
.osw{font-family:'Oswald',sans-serif;text-transform:uppercase}
.mono{font-family:'DejaVu Sans Mono',Menlo,monospace;text-transform:uppercase}

/* ---------- hero: the rotating diamond heart ---------- */
#hero{position:relative;height:100vh;min-height:640px;background:var(--cream);overflow:hidden}
#hero .dots{position:absolute;inset:0;pointer-events:none;z-index:2;
  background-image:radial-gradient(rgba(20,20,18,.12) 1.6px, transparent 1.6px);background-size:22px 22px}
#heartCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:3}
#hero .mast{position:absolute;left:0;right:0;top:0;z-index:6;display:flex;align-items:center;
  justify-content:space-between;padding:22px 40px;border-bottom:4px solid var(--tiffany);background:rgba(20,20,18,.85)}
#hero .mast a{color:var(--cream);text-decoration:none;font-size:14px;letter-spacing:5px;font-weight:600}
#hero .mast a:hover{color:var(--tiffany)}
#hero .mast .co{color:var(--tiffany);font-size:15px;letter-spacing:6px;font-weight:700}
#hero .titleblock{position:absolute;left:0;right:0;bottom:9vh;z-index:6;text-align:center;pointer-events:none}
#hero .titleblock h1{font-size:clamp(52px,8vw,120px);line-height:.95;color:var(--ink);letter-spacing:2px}
#hero .titleblock h1 span{color:var(--tiffany)}
#hero .titleblock p{color:#5a564b;font-size:15px;letter-spacing:7px;margin-top:14px;text-transform:uppercase;font-family:'Oswald',sans-serif}
#hero .enter{position:absolute;left:50%;transform:translateX(-50%);bottom:3vh;z-index:6;color:var(--tiffany);
  font-size:13px;letter-spacing:6px;text-decoration:none;font-family:'Oswald',sans-serif;text-transform:uppercase}
#hero .egglabels{position:absolute;inset:0;z-index:5;pointer-events:none;display:none}
#hero .egglabels .el{position:absolute;top:68%;width:25%;text-align:center;font-family:'Oswald',sans-serif;
  text-transform:uppercase;letter-spacing:3px;font-size:13px;font-weight:700;opacity:0;transition:opacity .8s}
#hero .egglabels .pink{left:0;color:#D2547E}
#hero .egglabels .blue{left:25%;color:var(--tiffany)}
#hero .egglabels .yellow{left:50%;color:#B8860B}
#hero .egglabels .green{left:75%;color:#3E8F4C}
#hero .egglabels .el span{display:block;font-size:11px;letter-spacing:4px;color:rgba(20,20,18,.6);margin-top:6px}
#hero .cat{position:absolute;left:40px;top:96px;z-index:6;color:rgba(20,20,18,.55);font-size:13px;letter-spacing:4px}

/* ---------- yin/yang ---------- */
#yinyang{display:grid;grid-template-columns:1fr 1fr;min-height:78vh}
@media(max-width:820px){#yinyang{grid-template-columns:1fr}}
#yinyang .half{padding:9vh 6vw;display:flex;flex-direction:column;justify-content:center;gap:22px;position:relative}
#yinyang .dlamar{background:var(--ink);color:var(--cream)}
#yinyang .lamarcy{background:var(--cream);color:var(--ink);
  background-image:radial-gradient(rgba(9,177,171,.12) 1.6px, transparent 1.6px);background-size:20px 20px}
#yinyang .k{font-size:13px;letter-spacing:8px;font-weight:700}
#yinyang .dlamar .k{color:var(--red)}
#yinyang .lamarcy .k{color:var(--tiffany)}
#yinyang h2{font-size:clamp(40px,4.5vw,68px);line-height:1}
#yinyang p{font-size:17px;line-height:1.7;max-width:46ch}
#yinyang .dlamar a{color:var(--sepia)}
#yinyang .lamarcy a{color:var(--ink)}
#yinyang .tag{font-size:13px;letter-spacing:4px;font-weight:600}
#yinyang .dlamar .tag{color:var(--sepia)}
#yinyang .lamarcy .tag{color:var(--tiffany)}
.yy-mark{position:absolute;top:40px;right:40px;width:64px;opacity:.9}

/* ---------- album ---------- */
section.block{padding:11vh 6vw;border-top:5px solid var(--ink)}
.kick{font-size:13px;letter-spacing:8px;color:var(--tiffany);font-weight:700;font-family:'Oswald',sans-serif;text-transform:uppercase}
section.block h2{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:clamp(40px,5vw,72px);margin:10px 0 18px}
section.block .lede{font-size:18px;font-style:italic;color:#3d3a33;max-width:62ch;line-height:1.7}
.coverrow{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:26px;margin-top:44px}
.coverrow figure{background:#fff;border:4px solid var(--ink);padding:10px;box-shadow:9px 9px 0 rgba(20,20,18,.85)}
.coverrow img{width:100%;display:block}
.coverrow figcaption{font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:3px;padding-top:9px;color:#3d3a33}
#instagram{background:var(--seafoam)}
#instagram .lede{color:#12312e}
.igrid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:44px}
@media(max-width:900px){.igrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.igrid{grid-template-columns:1fr}}
.igbox{display:block;background:#fff;border:4px solid var(--ink);padding:10px;box-shadow:9px 9px 0 rgba(20,20,18,.85);
  text-decoration:none;transition:transform .12s}
.igbox:hover{transform:translate(-2px,-2px)}
.igbox .ph{aspect-ratio:1/1;background:var(--cream);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  background-image:radial-gradient(rgba(20,20,18,.10) 1.6px, transparent 1.6px);background-size:18px 18px;overflow:hidden}
.igbox .ph img{width:88px}
.igbox .ph span{font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:3px;color:#3d3a33}
.igbox .ph .igimg{width:100%;height:100%;object-fit:cover}
.ignote{margin-top:34px;font-size:13px;letter-spacing:4px;color:var(--ink);text-transform:uppercase}
.ignote a{color:var(--ink);font-weight:700}

/* ---------- singles ---------- */
.songs{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:34px;margin-top:44px}
.song{border:4px solid var(--ink);background:#fff;box-shadow:10px 10px 0 rgba(20,20,18,.85)}
.song img{width:100%;display:block;border-bottom:4px solid var(--ink)}
.song .body{padding:24px 26px}
.song h3{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:30px}
.song .credits{font-size:14px;color:#5a564b;margin:8px 0 16px;font-style:italic}
.song .cta{display:inline-block;background:var(--ink);color:var(--cream);text-decoration:none;
  font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:13px;letter-spacing:4px;font-weight:700;padding:12px 22px}
.song .cta:hover{background:var(--tiffany);color:var(--ink)}
.song .buyrow{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.song button.cta.buy{display:none;border:0;cursor:pointer;background:var(--tiffany);color:var(--ink)}
.song button.cta.buy:hover{background:var(--ink);color:var(--cream)}
.song button.cta.buy[disabled]{opacity:.6;cursor:wait}
.song .buynote{display:none;font-family:'Oswald',sans-serif;text-transform:uppercase;
  font-size:11px;letter-spacing:3px;color:#5a564b;margin-top:12px}
.song .buyerr{display:none;font-size:14px;color:#5a564b;margin-top:8px;font-style:italic}
.song .playrow{display:none;align-items:center;gap:14px;margin-bottom:18px}
.song .pbtn{width:46px;height:46px;flex:0 0 46px;border:3px solid var(--ink);background:#fff;cursor:pointer;
  font-size:15px;line-height:1;box-shadow:4px 4px 0 rgba(20,20,18,.85);font-family:'Oswald',sans-serif}
.song .pbtn:hover{background:var(--tiffany)}
.song .pbar{flex:1;height:12px;border:3px solid var(--ink);background:#fff;position:relative;cursor:pointer}
.song .pfill{position:absolute;top:0;left:0;bottom:0;width:0%;background:var(--tiffany)}
.song .ptime{font-family:'DejaVu Sans Mono',Menlo,monospace;font-size:11px;color:#5a564b;min-width:84px;text-align:right}

/* ---------- chronicle / links ---------- */
#chronicle{background:var(--ink);color:var(--cream)}
#chronicle .lede{color:var(--sepia)}
.doors{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px;margin-top:44px}
.door{border:4px solid var(--cream);padding:28px;text-decoration:none;color:var(--cream);transition:all .15s}
.door:hover{background:var(--tiffany);color:var(--ink);border-color:var(--tiffany)}
.door .d1{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:26px}
.door .d2{font-size:14px;letter-spacing:3px;margin-top:8px;font-family:'Oswald',sans-serif;text-transform:uppercase}

footer{padding:44px 6vw;background:var(--ink);border-top:4px solid var(--tiffany);display:flex;flex-wrap:wrap;gap:18px;
  align-items:center;justify-content:space-between}
footer .mono{color:rgba(247,243,232,.5);font-size:12px;letter-spacing:4px}
footer img{height:40px}
body.locked{overflow:hidden;height:100vh}
#veil{position:fixed;inset:0;background:var(--ink);opacity:0;pointer-events:none;transition:opacity .55s ease;z-index:50}
#veil.on{opacity:1;pointer-events:auto}
#rest{display:none}
</style>
</head>
<body class="locked">

<!-- ============ HERO: the diamond heart ============ -->
<div id="veil"></div>
<div id="hero">
  <div class="dots"></div>
  <canvas id="heartCanvas"></canvas>
  <div class="egglabels" id="egglabels">
    <div class="el pink" id="lblPink">D.LAMAR · The Painter<span>the works · enter the gallery</span></div>
    <div class="el blue" id="lblBlue">LamarCy · The Songwriter<span>the music · enter the chronicle</span></div>
    <div class="el yellow" id="lblYellow">Ashley Smith · The Voice<span>her songs &amp; stories</span></div>
    <div class="el green" id="lblGreen">Durrell Smith · UX Design<span>the design work</span></div>
  </div>
  <div class="enter" id="hint" style="opacity:.65">❤ click the heart</div>
</div>

<div id="rest">
<!-- ============ YIN / YANG ============ -->
<div id="world"></div>
<div id="yinyang">
  <div class="half dlamar">
    <div class="k osw">The Yang · The Painter</div>
    <h2 class="anton">D.LAMAR</h2>
    <p>Watercolor, India ink, turmeric and duende — the visible work. Paintings that hang on walls,
       assemblages that hold their ground. This is the hand you can see.</p>
    <p class="tag osw"><a href="/art/#gallery">Enter the gallery →</a></p>
  </div>
  <div class="half lamarcy">
    <img class="yy-mark" src="/gateway/heart.png" alt="">
    <div class="k osw">The Yin · The Songwriter</div>
    <h2 class="anton">LamarCy</h2>
    <p>Southern blues, soul and rock written in Atlanta and haunted by Charleston — songs for other
       voices, chronicled in sepia and Tiffany blue. This is the hand you can hear.</p>
    <p class="tag osw">You're in the right room. Keep scrolling ↓</p>
  </div>
</div>

<!-- ============ INSTAGRAM ============ -->
<section class="block" id="instagram">
  <div class="kick">The Daily Chronicle</div>
  <h2>On Instagram</h2>
  <p class="lede">The making of the music, documented as it happens.</p>
  <div class="igrid" id="igrid">
    <a class="igbox" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="ph"><img src="/gateway/heart.png" alt=""><span>@_lamar_cy</span></div></a>
    <a class="igbox" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="ph"><img src="/gateway/heart.png" alt=""><span>@_lamar_cy</span></div></a>
    <a class="igbox" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="ph"><img src="/gateway/heart.png" alt=""><span>@_lamar_cy</span></div></a>
    <a class="igbox" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="ph"><img src="/gateway/heart.png" alt=""><span>@_lamar_cy</span></div></a>
    <a class="igbox" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="ph"><img src="/gateway/heart.png" alt=""><span>@_lamar_cy</span></div></a>
    <a class="igbox" href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">
      <div class="ph"><img src="/gateway/heart.png" alt=""><span>@_lamar_cy</span></div></a>
  </div>
  <p class="ignote osw">Follow along → <a href="https://www.instagram.com/_lamar_cy" target="_blank" rel="noopener">@_lamar_cy</a></p>
</section>

<!-- ============ THE SINGLES ============ -->
<section class="block" id="singles">
  <div class="kick">Now Playing</div>
  <h2>The Singles</h2>
  <p class="lede">&ldquo;I bet it&rsquo;s dolphins who know where the ocean gon&rsquo; hide the treasures of my soul.&rdquo;</p>
  <div class="songs">
    <div class="song">
      <img src="/gateway/single-lowcountry.jpg" alt="Lowcountry Beach single art">
      <div class="body">
        <h3>Lowcountry Beach</h3>
        <div class="credits">Written, played &amp; sung by Durrell Lamar · LC-001</div>
        <div class="playrow">
          <button class="pbtn" type="button" data-sku="lowcountry" aria-label="Play Lowcountry Beach">▶</button>
          <div class="pbar"><div class="pfill"></div></div>
          <div class="ptime">0:00 / 0:00</div>
        </div>
        <div class="buyrow">
          <button class="cta buy" type="button" data-sku="lowcountry">Own it · $0.99+</button>
          <a class="cta" href="https://lamarcy.bandcamp.com" target="_blank" rel="noopener">Hear it on Bandcamp</a>
        </div>
        <div class="buynote">MP3 · Pay what you want from $0.99 · Checkout by Stripe</div>
        <div class="buyerr"></div>
      </div>
    </div>
    <div class="song">
      <img src="/gateway/single-momma.jpg" alt="Momma Gone single art">
      <div class="body">
        <h3>Momma Gone</h3>
